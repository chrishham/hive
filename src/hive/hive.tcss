Screen {
    layout: vertical;
}

#header {
    dock: top;
    height: 1;
    background: $boost;
    color: $text;
    padding: 0 1;
}

#main {
    layout: horizontal;
    height: 1fr;
}

#splash {
    width: 100%;
    height: 1fr;
    content-align: center middle;
    color: $warning;
    text-style: bold;
}

.hidden {
    display: none;
}

#session-panel {
    width: 1fr;
    min-width: 30;
    border-right: solid $primary;
}

#preview-panel {
    width: 1fr;
    min-width: 30;
    padding: 0 1;
}

#footer-bar {
    dock: bottom;
    height: 1;
    background: $primary-background;
    color: $text-muted;
    padding: 0 1;
}

SessionListItem {
    height: auto;
    padding: 0 1;
}

SessionListItem.-highlight {
    background: $primary 30%;
}

.session-header {
    text-style: bold;
}

.session-project {
    color: $text-muted;
}

.session-model {
    color: $text-muted;
}

.session-url {
    color: $text-muted;
}

ModalScreen {
    align: center middle;
}

#picker-dialog, #options-dialog, #clone-dialog, #exists-dialog, #confirm-dialog, #rename-dialog {
    width: 70;
    max-height: 80%;
    border: thick $primary;
    background: $surface;
    padding: 1 2;
}

#picker-filter, #clone-url, #rename-input, #session-name {
    margin: 1 0;
}

ErrorScreen {
    align: center middle;
}

#error-dialog {
    width: 70;
    max-height: 80%;
    border: thick $error;
    background: $surface;
    padding: 1 2;
}

#error-title {
    text-style: bold;
    color: $error;
    padding-bottom: 1;
}

#error-message {
    padding-bottom: 1;
}

#error-buttons {
    align-horizontal: right;
    height: auto;
}

.banner {
    width: 100%;
    height: auto;
    padding: 0 1;
    display: none;
}

.banner-info { background: $primary 30%; color: $text; }
.banner-warn { background: $warning 30%; color: $text; }
.banner-error { background: $error 30%; color: $text; }

#info-banner.has-text, #warning-banner.has-text, #error-banner.has-text {
    display: block;
}
